---
interface Props {
  href: string;
  name: string;
  description?: string;
  badge?: string;
}

const { href, name, description, badge } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="nofollow noopener noreferrer"
  data-affiliate="true"
  class="group flex items-start justify-between gap-4 rounded-2xl border border-[#2E2E2E] bg-[#1A1A1A] p-4 text-left transition-all duration-200 hover:-translate-y-0.5 hover:border-[#F472B6]"
>
  <div class="min-w-0 space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-base font-semibold text-[#F5F5F5]">{name}</span>
      {badge && (
        <span class="rounded-full bg-[#9D174D]/30 px-2.5 py-1 text-xs font-medium text-[#F472B6]">
          {badge}
        </span>
      )}
    </div>

    {description && <p class="text-sm leading-6 text-[#999999]">{description}</p>}
  </div>

  <span class="mt-0.5 shrink-0 text-[#F472B6]" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      class="size-5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5H19.5V10.5" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 13.5L19.5 4.5" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13V18.75C19.5 19.1642 19.1642 19.5 18.75 19.5H5.25C4.83579 19.5 4.5 19.1642 4.5 18.75V5.25C4.5 4.83579 4.83579 4.5 5.25 4.5H11" />
    </svg>
  </span>
</a>
