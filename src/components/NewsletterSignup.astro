---
interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = 'Join the Den',
  subtext = 'Weekly dispatches from life with T1D — honest, practical, and never boring.',
} = Astro.props;

// Set PUBLIC_KIT_FORM_ID in your .env file to activate the newsletter form.
// e.g.  PUBLIC_KIT_FORM_ID=1234567
const formId = import.meta.env.PUBLIC_KIT_FORM_ID;
const formAction = formId ? `https://app.kit.com/forms/${formId}/subscriptions` : null;
const isDev = import.meta.env.DEV;
---

<section class="rounded-2xl border border-[#2E2E2E] p-6" style="border-left: 4px solid var(--color-accent); background: var(--color-surface);">
  <div class="space-y-3">
    <h2 class="text-3xl text-[#F5F5F5]" style="font-family: 'Playfair Display', serif;">{heading}</h2>
    <p class="text-sm leading-6 text-[#999999]">{subtext}</p>
  </div>

  <!-- Update YOUR_FORM_ID in the action URL with your Kit form ID before going live. -->
  {isDev && !formId && (
    <p style="color:#F0883E;font-size:0.75rem;margin-bottom:0.5rem;">
      ⚠ Dev: Set <code>PUBLIC_KIT_FORM_ID</code> in your <code>.env</code> to activate this form.
    </p>
  )}
  {formAction ? (
  <form
    action={formAction}
    method="post"
    class="mt-6 flex flex-col gap-3 sm:flex-row"
  >
    <label class="sr-only" for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      type="email"
      name="email_address"
      autocomplete="email"
      required
      placeholder="you@example.com"
      class="min-h-12 flex-1 rounded-xl border border-[#2E2E2E] bg-[#0F0F0F] px-4 text-[#F5F5F5] placeholder:text-[#999999] focus:border-[var(--color-accent)] focus:outline-none"
    />
    <button
      type="submit"
      class="button-pink min-h-12 rounded-xl px-5"
    >
      Subscribe
    </button>
  </form>
  ) : (
  <p style="color:var(--color-text-tertiary);font-size:0.875rem;margin-top:1.5rem;">Newsletter coming soon — stay tuned!</p>
  )}

  <p class="mt-3 text-xs text-[#999999]">No spam. Unsubscribe anytime.</p>
</section>
