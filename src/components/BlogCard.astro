---
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  description: string;
  category: string;
  image?: string;
}

const { title, slug, pubDate, description, category, image } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const categoryGradients: Record<string, string> = {
  'Life with T1D': 'linear-gradient(135deg, #F472B6 0%, #BE185D 100%)',
  'Tech & Gear':   'linear-gradient(135deg, #38BDF8 0%, #0369A1 100%)',
  'Nutrition':     'linear-gradient(135deg, #4ADE80 0%, #15803D 100%)',
  'Advocacy':      'linear-gradient(135deg, #C084FC 0%, #6D28D9 100%)',
  'Mindset':       'linear-gradient(135deg, #FCD34D 0%, #B45309 100%)',
};

const gradient = categoryGradients[category] ?? categoryGradients['Life with T1D'];
---

<a
  href={`/blog/${slug}`}
  class="card-link group flex h-full flex-col overflow-hidden rounded-2xl border border-[#272727] bg-[#141414]"
>
  <!-- Cover -->
  <div class="cover-wrap relative shrink-0 overflow-hidden" style="height:160px;">
    {image ? (
      <img
        src={image}
        alt=""
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div
        class="h-full w-full transition-transform duration-700 group-hover:scale-110"
        style={`background: ${gradient}`}
      />
    )}
    <div class="noise-overlay absolute inset-0 opacity-[0.15]" aria-hidden="true" />
    <!-- category pill -->
    <span class="absolute bottom-3 left-3 rounded-full bg-black/55 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest text-white backdrop-blur-sm">
      {category}
    </span>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h2
      class="line-clamp-2 leading-snug text-[#F0F0F0] transition-colors duration-200 group-hover:text-[#F472B6]"
      style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:600; margin:0;"
      transition:name={`post-title-${slug}`}
    >
      {title}
    </h2>
    <p class="line-clamp-2 text-sm leading-relaxed text-[#666]" style="margin:0;">{description}</p>

    <div class="mt-auto flex items-center justify-between pt-2" style="border-top:1px solid #1E1E1E; padding-top:0.75rem; margin-top:0.5rem;">
      <p class="text-[11px] font-medium uppercase tracking-[0.12em] text-[#444]">{formattedDate}</p>
      <span class="read-more flex items-center gap-1 text-[11px] font-semibold text-[#555] transition-colors duration-200 group-hover:text-[#F472B6]" aria-hidden="true">
        Read
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card-link:hover {
    border-color: rgba(244, 114, 182, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(244,114,182,0.1);
  }
  .noise-overlay {
    background-image: url('data:image/svg+xml,%3Csvg viewBox%3D%220 0 200 200%22 xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cfilter id%3D%22n%22%3E%3CfeTurbulence type%3D%22fractalNoise%22 baseFrequency%3D%220.9%22 numOctaves%3D%224%22 stitchTiles%3D%22stitch%22%2F%3E%3C%2Ffilter%3E%3Crect width%3D%22100%25%22 height%3D%22100%25%22 filter%3D%22url(%23n)%22%2F%3E%3C%2Fsvg%3E');
    background-size: 150px;
  }
</style>

