---
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  description: string;
  category: string;
  image?: string;
}

const { title, slug, pubDate, description, category, image } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const categoryGradients: Record<string, string> = {
  'Life with T1D': 'linear-gradient(135deg, #F472B6 0%, #9D174D 100%)',
  'Tech & Gear':   'linear-gradient(135deg, #60A5FA 0%, #1D4ED8 100%)',
  'Nutrition':     'linear-gradient(135deg, #34D399 0%, #065F46 100%)',
  'Advocacy':      'linear-gradient(135deg, #A78BFA 0%, #4C1D95 100%)',
  'Mindset':       'linear-gradient(135deg, #FBBF24 0%, #92400E 100%)',
};

const gradient = categoryGradients[category] ?? categoryGradients['Life with T1D'];
---

<a
  href={`/blog/${slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-[#2E2E2E] bg-[#1A1A1A] transition-all duration-200 hover:-translate-y-1 hover:border-[#F472B6] hover:shadow-lg hover:shadow-black/40"
>
  <!-- Cover band -->
  <div class="relative h-36 shrink-0 overflow-hidden">
    {image ? (
      <img
        src={image}
        alt=""
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="h-full w-full transition-transform duration-500 group-hover:scale-105" style={`background: ${gradient}`} />
    )}
    <!-- subtle noise overlay -->
    <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg viewBox%3D%220 0 200 200%22 xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cfilter id%3D%22n%22%3E%3CfeTurbulence type%3D%22fractalNoise%22 baseFrequency%3D%220.9%22 numOctaves%3D%224%22 stitchTiles%3D%22stitch%22%2F%3E%3C%2Ffilter%3E%3Crect width%3D%22100%25%22 height%3D%22100%25%22 filter%3D%22url(%23n)%22%2F%3E%3C%2Fsvg%3E'); background-size: 150px;" />
    <!-- category pill -->
    <span class="absolute bottom-3 left-3 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white backdrop-blur-sm">
      {category}
    </span>
  </div>

  <!-- Card content -->
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h2
      class="line-clamp-2 text-lg font-semibold leading-snug text-[#F5F5F5] transition-colors group-hover:text-[#F472B6]"
      style="font-family: 'Playfair Display', serif;"
      transition:name={`post-title-${slug}`}
    >
      {title}
    </h2>
    <p class="line-clamp-2 text-sm leading-6 text-[#999999]">{description}</p>
    <div class="mt-auto flex items-center justify-between pt-3">
      <p class="text-xs uppercase tracking-[0.15em] text-[#666666]">{formattedDate}</p>
      <!-- Animated draw-in arrow (Astro-sphere pattern) -->
      <span class="flex items-center gap-1 text-xs text-[#666666] transition-colors group-hover:text-[#F472B6]" aria-hidden="true">
        <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="overflow-visible">
          <line
            x1="0" y1="6" x2="13" y2="6"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            class="origin-left scale-x-0 translate-x-1 transition-all duration-300 ease-out group-hover:scale-x-100 group-hover:translate-x-0"
          />
          <polyline
            points="8,1 14,6 8,11"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            class="translate-x-0 transition-all duration-300 ease-out group-hover:translate-x-1"
          />
        </svg>
      </span>
    </div>
  </div>
</a>
