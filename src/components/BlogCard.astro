---
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  description: string;
  category: string;
  image?: string;
  readTime?: number;
}

const { title, slug, pubDate, description, category, image, readTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

// Thin accent color per category (top border + pill)
const categoryColors: Record<string, string> = {
  'Life with T1D': '#5E8C8A',
  'Tech & Gear':   '#58A6FF',
  'Nutrition':     '#3FB950',
  'Advocacy':      '#9B8DB3',
  'Mindset':       '#F0883E',
};
const color = categoryColors[category] ?? '#5E8C8A';
---

<a
  href={`/blog/${slug}`}
  class="card-link fade-up group flex h-full flex-col overflow-hidden rounded-xl border border-[#30363D] bg-[#161B22]"
  style={`border-top: 3px solid ${color};`}
>
  <!-- Optional photo cover — only shown when image prop is set -->
  {image && (
    <div class="relative shrink-0 overflow-hidden" style="height:140px;">
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
        width="640"
        height="140"
      />
    </div>
  )}

  <!-- Content -->
  <div class="flex flex-1 flex-col gap-3 p-5">
    <!-- Category pill -->
    <span class="inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest"
      style={`background: ${color}18; color: ${color}; border: 1px solid ${color}30;`}>
      {category}
    </span>

    <h2
      class="line-clamp-2 leading-snug text-[#E6EDF3] transition-colors duration-200 group-hover:text-[#6E9E9C]"
      style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:600; margin:0;"
      transition:name={`post-title-${slug}`}
    >
      {title}
    </h2>
    <p class="line-clamp-2 text-sm leading-relaxed text-[#8B949E]" style="margin:0;">{description}</p>

    <div class="mt-auto flex items-center justify-between" style="border-top:1px solid #21262D; padding-top:0.75rem; margin-top:0.5rem;">
      <div style="display:flex; flex-direction:column; gap:0.1rem;">
        <p class="text-[11px] font-medium" style="color:var(--color-text-tertiary);">{formattedDate}</p>
        {readTime && <p class="text-[11px]" style="color:var(--color-text-tertiary);">{readTime} min read</p>}
      </div>
      <span class="flex items-center gap-1 text-[11px] font-semibold transition-colors duration-200 group-hover:text-[#6E9E9C]" style="color:var(--color-text-tertiary);" aria-hidden="true">
        Read
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, opacity 0.6s ease;
  }
  .card-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
</style>


