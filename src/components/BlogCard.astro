---
import { Image } from 'astro:assets';
import { getCategoryVar } from '../utils/categoryColors';

interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  description: string;
  category: string;
  image?: string;
  readTime?: number;
}

const { title, slug, pubDate, description, category, image, readTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const color = getCategoryVar(category);
---

<a
  href={`/blog/${slug}`}
  class="card-link fade-up group flex h-full flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]"
  style={`border-top: 3px solid ${color};`}
>
  <!-- Optional photo cover — only shown when image prop is set -->
  {image && (
    <div class="relative shrink-0 overflow-hidden" style="height:140px;">
      <Image
        src={image}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        width={640}
        height={140}
        format="webp"
      />
    </div>
  )}

  <!-- Content -->
  <div class="flex flex-1 flex-col gap-3 p-5">
    <!-- Category pill -->
    <span class="inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest"
      style={`background: color-mix(in srgb, ${color} 9%, transparent); color: ${color}; border: 1px solid color-mix(in srgb, ${color} 19%, transparent);`}>
      {category}
    </span>

    <h2
      class="line-clamp-2 leading-snug text-[var(--color-text-primary)] transition-colors duration-200 group-hover:text-[var(--color-accent-hover)]"
      style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:600; margin:0;"
      transition:name={`post-title-${slug}`}
    >
      {title}
    </h2>
    <p class="line-clamp-2 text-sm leading-relaxed text-[var(--color-text-secondary)]" style="margin:0;">{description}</p>

    <div class="mt-auto flex items-center justify-between" style="border-top:1px solid var(--color-border-subtle); padding-top:0.75rem; margin-top:0.5rem;">
      <div style="display:flex; flex-direction:column; gap:0.1rem;">
        <p class="text-[11px] font-medium" style="color:var(--color-text-tertiary);">{formattedDate}</p>
        {readTime && <p class="text-[11px]" style="color:var(--color-text-tertiary);">{readTime} min read</p>}
      </div>
      <span class="flex items-center gap-1 text-[11px] font-semibold transition-colors duration-200 group-hover:text-[var(--color-accent-hover)]" style="color:var(--color-accent);" aria-hidden="true">
        Read
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .card-link {
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, opacity 0.6s ease;
  }
  .card-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
</style>


