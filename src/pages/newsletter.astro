---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---

<BaseLayout
  title="Newsletter | Type One Den"
  description="Join the Type One Den newsletter for weekly posts, exclusive tips, and early access to new resources."
>
  <main class="page-main py-16">
    <div class="max-w-[720px] mx-auto px-4 space-y-10 text-center">
      <header class="space-y-5">
        <p class="page-eyebrow">Newsletter</p>
        <h1 class="text-4xl md:text-5xl" style="font-family: 'Playfair Display', serif;">Join the Den</h1>
        <p class="text-lg page-muted">Get the kind of T1D email you&apos;ll actually want to open: weekly posts, exclusive tips, and early access to the tools and guides I&apos;m building for this community.</p>
      </header>

      <section class="page-panel space-y-6">
        <div class="grid gap-4 md:grid-cols-3 text-left">
          <div class="page-panel-inner">
            <h2 class="font-semibold" style="color:var(--color-text-primary);">Weekly posts</h2>
            <p class="mt-2 text-sm page-muted">Fresh stories, practical tips, and thoughtful reflections on life with T1D.</p>
          </div>
          <div class="page-panel-inner">
            <h2 class="font-semibold" style="color:var(--color-text-primary);">Exclusive tips</h2>
            <p class="mt-2 text-sm page-muted">Subscriber-only notes on routines, products, mindset, and staying steady through the messy days.</p>
          </div>
          <div class="page-panel-inner">
            <h2 class="font-semibold" style="color:var(--color-text-primary);">Early access</h2>
            <p class="mt-2 text-sm page-muted">Be first to see new downloads, resource guides, and future Type One Den launches.</p>
          </div>
        </div>
        <p class="page-eyebrow">Join 1,000+ T1D readers</p>
        <NewsletterSignup heading="Get on the list" subtext="This social proof is a placeholder and can be updated once the newsletter is live." />
      </section>
    </div>
  </main>
</BaseLayout>
