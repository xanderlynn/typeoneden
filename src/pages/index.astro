---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

const allPosts = (await getCollection('blog').catch(() => []))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    readTime: Math.max(1, Math.ceil(post.body.split(/\s+/).filter(Boolean).length / 200)),
  }));

const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1, 3);

// Set PUBLIC_HERO_VIDEO_ID in .env to show the YouTube section on the homepage.
// e.g.  PUBLIC_HERO_VIDEO_ID=dQw4w9WgXcQ
const heroVideoId = import.meta.env.PUBLIC_HERO_VIDEO_ID;
---

<BaseLayout
  title="TypeOneDen — Living Boldly with Type 1"
  description="TypeOneDen is your guide to thriving with T1D through honest stories, practical resources, and real community."
>
  <main>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="relative" style="min-height:95vh; display:flex; align-items:center; border-bottom:1px solid var(--color-border);">

      <div class="wide-container px-4 py-28 md:py-40">
        <div class="fade-up" style="max-width:960px; margin:0 auto; text-align:center;">

          <!-- Eyebrow -->
          <p style="font-size:0.65rem; font-weight:700; letter-spacing:0.42em; text-transform:uppercase; color:var(--color-accent); margin:0 0 3rem;">
            T1D &nbsp;·&nbsp; Lifestyle &nbsp;·&nbsp; Community
          </p>

          <!-- Editorial headline -->
          <h1 style="font-family:var(--font-serif); font-size:clamp(3.8rem,10vw,7.5rem); line-height:0.92; letter-spacing:-0.025em; font-weight:700; margin:0 0 2.5rem; color:var(--color-text-primary);">
            Living<br/>
            <em style="font-style:italic; color:var(--color-accent);">Boldly</em><br/>
            <span style="opacity:0.55;">with Type&nbsp;1</span>
          </h1>

          <!-- Subtitle -->
          <p style="font-size:1.05rem; color:var(--color-text-secondary); line-height:1.9; max-width:480px; margin:0 auto 3rem;">
            Real stories, honest tech reviews, T1D nutrition, and a community
            that actually understands what it takes.
          </p>

          <!-- CTAs -->
          <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
            <a href="/blog" class="button-accent">
              Read the Blog
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
            <a href="/start" class="button-outline">Start Here</a>
          </div>

          <!-- Horizontal category rule -->
          <div style="margin-top:4.5rem; padding-top:2rem; border-top:1px solid var(--color-border); display:flex; justify-content:center; align-items:center; gap:0; flex-wrap:wrap;">
            {[
              'Real T1D stories',
              'CGM & pump reviews',
              'T1D nutrition',
              'Advocacy',
            ].map((label, i) => (
              <span style={`font-size:0.62rem; font-weight:600; letter-spacing:0.22em; text-transform:uppercase; color:var(--color-text-tertiary); padding:0 1.75rem; ${i > 0 ? 'border-left:1px solid var(--color-border);' : ''}`}>
                {label}
              </span>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- ── Featured Post ──────────────────────────────────────── -->
    {featuredPost && (
      <section style="padding-block:5rem; border-bottom:1px solid var(--color-border);">
        <div class="wide-container px-4 space-y-8">
          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <p class="section-label">Featured Post</p>
            <a href="/blog" style="font-size:0.8rem; color:var(--color-text-secondary); text-decoration:none; display:flex; align-items:center; gap:0.3rem;" class="hover:text-[var(--color-accent)]">
              All posts
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
          </div>

          <a
            href={`/blog/${featuredPost.slug}`}
            style="display:grid; gap:0; border:1px solid var(--color-border); border-radius:1.25rem; overflow:hidden; background:var(--color-surface); text-decoration:none; transition:border-color 0.2s, box-shadow 0.2s;"
            class="group featured-card md:grid-cols-[1fr_1fr]"
          >
            <!-- Accent panel (thin) + category info -->
            <div style={`position:relative; min-height:220px; background:var(--color-surface-2); display:flex; align-items:flex-end; padding:1.5rem; border-right:1px solid var(--color-border);`}>
              <div style={`position:absolute; left:0; top:0; bottom:0; width:5px; background:${ {'Life with T1D':'var(--color-accent)','Tech & Gear':'#58A6FF','Nutrition':'#3FB950','Advocacy':'#9B8DB3','Mindset':'#F0883E'}[featuredPost.data.category] ?? 'var(--color-accent)'};`} />
              <div style="padding-left:1rem;">
                <span style={`display:inline-flex;align-items:center;border-radius:9999px;padding:0.3rem 0.85rem;font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em; background:${ {'Life with T1D':'var(--color-accent-dim)','Tech & Gear':'#58A6FF18','Nutrition':'#3FB95018','Advocacy':'#9B8DB318','Mindset':'#F0883E18'}[featuredPost.data.category] ?? 'var(--color-accent-dim)'}; color:${ {'Life with T1D':'var(--color-accent)','Tech & Gear':'#58A6FF','Nutrition':'#3FB950','Advocacy':'#9B8DB3','Mindset':'#F0883E'}[featuredPost.data.category] ?? 'var(--color-accent)'};`}>
                  {featuredPost.data.category}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div style="padding:2rem 2.5rem; display:flex; flex-direction:column; justify-content:space-between; gap:1.5rem;">
              <div>
                <p style="font-size:0.72rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-text-tertiary);margin-bottom:0.85rem;">
                  {featuredPost.data.pubDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}
                </p>
                <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3vw,2.1rem);line-height:1.2;font-weight:700;color:var(--color-text-primary);margin:0 0 1rem;" class="group-hover:text-[var(--color-accent)] transition-colors">
                  {featuredPost.data.title}
                </h2>
                <p style="color:var(--color-text-secondary);font-size:0.95rem;line-height:1.7;margin:0;">{featuredPost.data.description}</p>
              </div>
              <span style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.8rem;font-weight:600;color:var(--color-accent);">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </span>
            </div>
          </a>

          <!-- Two recent posts below featured -->
          {recentPosts.length > 0 && (
            <div style="display:grid; gap:1.25rem;" class="md:grid-cols-2">
              {recentPosts.map((post) => (
                <BlogCard
                  title={post.data.title}
                  slug={post.id}
                  pubDate={post.data.pubDate}
                  description={post.data.description}
                  category={post.data.category}
                  image={post.data.image}
                  readTime={post.readTime}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ── YouTube ─────────────────────────────────────────────── -->
    {heroVideoId && (
    <section style="padding-block:5rem; border-bottom:1px solid var(--color-border); background:var(--color-bg);">
      <div class="wide-container px-4 md:grid-cols-[1fr_1.4fr]" style="display:grid; gap:3rem;">
        <div style="space-y:1.25rem;">
          <p class="section-label" style="margin-bottom:1rem;">YouTube</p>
          <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,2.5rem);line-height:1.15;font-weight:700;color:var(--color-text-primary);margin:0 0 1rem;">Watch the latest video</h2>
          <p style="color:var(--color-text-secondary);font-size:0.95rem;line-height:1.7;margin:0 0 1.5rem;">Real talk about life with T1D — tech breakdowns, day-in-the-life vlogs, and community conversations.</p>
          <a href="/youtube" class="button-outline">View all videos</a>
        </div>
        <YouTubeEmbed videoId={heroVideoId} title="Latest TypeOneDen video" />
      </div>
    </section>
    )}

    <!-- ── Newsletter ──────────────────────────────────────────── -->
    <section style="padding-block:5rem; position:relative; overflow:hidden;">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="wide-container px-4" style="position:relative;">
        <NewsletterSignup heading="Join the Den newsletter" subtext="Weekly T1D stories, practical tips, and the first look at new resources — straight to your inbox." />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .featured-card {
    display: grid;
  }
  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 1fr 1fr;
    }
  }
  .featured-card:hover {
    border-color: var(--color-accent) !important;
    box-shadow: 0 8px 40px rgba(200,168,122,0.12);
  }
  .md\:grid-cols-2 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .md\:grid-cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .md\:grid-cols-\[1fr_1\.4fr\] {
      grid-template-columns: 1fr 1.4fr;
    }
  }
</style>

