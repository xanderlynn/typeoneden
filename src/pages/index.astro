---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

const latestPosts = (await getCollection('blog').catch(() => []))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Type One Den"
  description="Type One Den is your guide to thriving with T1D through honest stories, practical resources, and real community."
>
  <main class="bg-[#0F0F0F] text-[#F5F5F5]" style="font-family: Inter, sans-serif;">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-[#2E2E2E] py-24 md:py-32">
      <!-- Subtle pink glow from top -->
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[500px]" style="background: radial-gradient(ellipse 70% 40% at 50% -5%, oklch(0.55 0.18 330 / 0.22), transparent);" aria-hidden="true" />
      <div class="relative max-w-[760px] mx-auto px-4 text-center space-y-7">
        <span class="eyebrow">Type 1 Diabetes</span>
        <h1 class="text-5xl md:text-7xl leading-[1.1] tracking-tight" style="font-family: 'Playfair Display', serif;">Living Boldly<br/>with Type&nbsp;1</h1>
        <p class="text-lg md:text-xl leading-8 text-[#999999] max-w-[540px] mx-auto">Your guide to thriving with T1D — real talk, real resources, real community.</p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row pt-2">
          <a href="/blog" class="button-accent">Read the Blog</a>
          <a href="/start" class="button-outline">Start Here</a>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 space-y-8">
        <div class="max-w-[720px] space-y-3">
          <p class="text-sm uppercase tracking-[0.3em] text-[#F472B6]">Latest Posts</p>
          <h2 class="text-3xl md:text-4xl" style="font-family: 'Playfair Display', serif;">Fresh from the blog</h2>
          <p class="leading-8 text-[#999999]">New stories, practical guides, and honest notes from real life with T1D.</p>
        </div>

        {latestPosts.length > 0 ? (
          <div class="grid gap-6 lg:grid-cols-3 md:grid-cols-2">
            {latestPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                slug={post.slug}
                pubDate={post.data.pubDate}
                description={post.data.description}
                category={post.data.category}
                image={post.data.image}
              />
            ))}
          </div>
        ) : (
          <div class="rounded-3xl border border-dashed border-[#2E2E2E] bg-[#1A1A1A] p-8 text-center text-[#999999]">
            Blog posts will show up here once the collection is populated.
          </div>
        )}
      </div>
    </section>

    <section class="border-y border-[#2E2E2E] bg-[#1A1A1A] py-16">
      <div class="max-w-[720px] mx-auto px-4 space-y-5">
        <div class="space-y-3">
          <p class="text-sm uppercase tracking-[0.3em] text-[#F472B6]">Featured Video</p>
          <h2 class="text-3xl md:text-4xl" style="font-family: 'Playfair Display', serif;">Featured YouTube Video</h2>
          <p class="leading-8 text-[#999999]">A placeholder feature until the first Type One Den video goes live on YouTube.</p>
        </div>
        <YouTubeEmbed videoId="dQw4w9WgXcQ" title="Placeholder: Welcome to Type One Den" />
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-[720px] mx-auto px-4">
        <NewsletterSignup heading="Join the Den newsletter" subtext="Get weekly T1D stories, practical tips, and the first look at new resources." />
      </div>
    </section>
  </main>
</BaseLayout>
