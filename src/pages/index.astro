---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

const allPosts = (await getCollection('blog').catch(() => []))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    readTime: Math.max(1, Math.ceil(post.body.split(/\s+/).filter(Boolean).length / 200)),
  }));

const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1, 3);
---

<BaseLayout
  title="TypeOneDen — Living Boldly with Type 1"
  description="TypeOneDen is your guide to thriving with T1D through honest stories, practical resources, and real community."
>
  <main>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-[#30363D]" style="min-height: 88vh; display: flex; align-items: center;">

      <!-- Dot grid texture -->
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>

      <!-- Purple glow orbs (Copilot-style) -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div style="position:absolute; top:-120px; left:50%; transform:translateX(-50%); width:800px; height:500px; background:radial-gradient(ellipse, rgba(137,87,229,0.2) 0%, transparent 70%); filter:blur(40px);"></div>
        <div style="position:absolute; bottom:0; right:-100px; width:400px; height:400px; background:radial-gradient(ellipse, rgba(88,166,255,0.07) 0%, transparent 70%);"></div>
      </div>

      <div class="relative wide-container px-4 py-28 md:py-36">
        <div class="mx-auto max-w-[780px] space-y-8 text-center fade-up">

          <!-- Eyebrow -->
          <div>
            <span class="eyebrow">
              <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#A67C8A;"></span>
              T1D Lifestyle &amp; Community
            </span>
          </div>

          <!-- Headline -->
          <h1 style="font-family:'Playfair Display',serif; font-size:clamp(3rem,8vw,5.5rem); line-height:1.05; letter-spacing:-0.02em; font-weight:700;">
            <span class="text-gradient">Living Boldly</span><br/>
            <span style="color:#E6EDF3;">with Type&nbsp;1</span>
          </h1>

          <!-- Sub -->
          <p style="font-size:clamp(1rem,2.5vw,1.2rem); color:#8B949E; line-height:1.75; max-width:520px; margin-inline:auto;">
            Real stories, honest tech reviews, T1D nutrition, and a community
            that actually gets it. No sugar-coating — just real life.
          </p>

          <!-- CTAs -->
          <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap; padding-top:0.5rem;">
            <a href="/blog" class="button-accent">
              Read the Blog
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
            <a href="/start" class="button-outline">Start Here</a>
          </div>

          <!-- Social proof pills -->
          <div style="display:flex; gap:0.6rem; justify-content:center; flex-wrap:wrap; padding-top:0.75rem;">
            {[
              '💉 Real T1D experiences',
              '⌚ CGM & pump reviews',
              '🥗 T1D nutrition tips',
              '📢 Advocacy & access',
            ].map((pill) => (
              <span style="border:1px solid #30363D; background:#161B22; border-radius:9999px; padding:0.3rem 0.85rem; font-size:0.75rem; color:#8B949E; white-space:nowrap;">
                {pill}
              </span>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- ── Featured Post ──────────────────────────────────────── -->
    {featuredPost && (
      <section style="padding-block:5rem; border-bottom:1px solid #30363D;">
        <div class="wide-container px-4 space-y-8">
          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <p class="section-label">Featured Post</p>
            <a href="/blog" style="font-size:0.8rem; color:#8B949E; text-decoration:none; display:flex; align-items:center; gap:0.3rem;" class="hover:text-[#B88E9C]">
              All posts
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
          </div>

          <a
            href={`/blog/${featuredPost.slug}`}
            style="display:grid; gap:0; border:1px solid #30363D; border-radius:1.25rem; overflow:hidden; background:#161B22; text-decoration:none; transition:border-color 0.2s, box-shadow 0.2s;"
            class="group featured-card md:grid-cols-[1fr_1fr]"
          >
            <!-- Accent panel (thin) + category info -->
            <div style={`position:relative; min-height:220px; background:#1C2128; display:flex; align-items:flex-end; padding:1.5rem; border-right:1px solid #30363D;`}>
              <div style={`position:absolute; left:0; top:0; bottom:0; width:5px; background:${ {'Life with T1D':'#A67C8A','Tech & Gear':'#58A6FF','Nutrition':'#3FB950','Advocacy':'#9B8DB3','Mindset':'#F0883E'}[featuredPost.data.category] ?? '#A67C8A'};`} />
              <div style="padding-left:1rem;">
                <span style={`display:inline-flex;align-items:center;border-radius:9999px;padding:0.3rem 0.85rem;font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em; background:${ {'Life with T1D':'#A67C8A18','Tech & Gear':'#58A6FF18','Nutrition':'#3FB95018','Advocacy':'#9B8DB318','Mindset':'#F0883E18'}[featuredPost.data.category] ?? '#A67C8A18'}; color:${ {'Life with T1D':'#A67C8A','Tech & Gear':'#58A6FF','Nutrition':'#3FB950','Advocacy':'#9B8DB3','Mindset':'#F0883E'}[featuredPost.data.category] ?? '#A67C8A'};`}>
                  {featuredPost.data.category}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div style="padding:2rem 2.5rem; display:flex; flex-direction:column; justify-content:space-between; gap:1.5rem;">
              <div>
                <p style="font-size:0.72rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:#484F58;margin-bottom:0.85rem;">
                  {featuredPost.data.pubDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}
                </p>
                <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3vw,2.1rem);line-height:1.2;font-weight:700;color:#E6EDF3;margin:0 0 1rem;" class="group-hover:text-[#B88E9C] transition-colors">
                  {featuredPost.data.title}
                </h2>
                <p style="color:#8B949E;font-size:0.95rem;line-height:1.7;margin:0;">{featuredPost.data.description}</p>
              </div>
              <span style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.8rem;font-weight:600;color:#A67C8A;">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </span>
            </div>
          </a>

          <!-- Two recent posts below featured -->
          {recentPosts.length > 0 && (
            <div style="display:grid; gap:1.25rem;" class="md:grid-cols-2">
              {recentPosts.map((post) => (
                <BlogCard
                  title={post.data.title}
                  slug={post.slug}
                  pubDate={post.data.pubDate}
                  description={post.data.description}
                  category={post.data.category}
                  image={post.data.image}
                  readTime={post.readTime}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ── YouTube ─────────────────────────────────────────────── -->
    <section style="padding-block:5rem; border-bottom:1px solid #30363D; background:#0D1117;">
      <div class="wide-container px-4" style="display:grid; gap:3rem;" class="md:grid-cols-[1fr_1.4fr]">
        <div style="space-y:1.25rem;">
          <p class="section-label" style="margin-bottom:1rem;">YouTube</p>
          <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,2.5rem);line-height:1.15;font-weight:700;color:#E6EDF3;margin:0 0 1rem;">Watch the latest video</h2>
          <p style="color:#8B949E;font-size:0.95rem;line-height:1.7;margin:0 0 1.5rem;">Real talk about life with T1D — tech breakdowns, day-in-the-life vlogs, and community conversations.</p>
          <a href="/youtube" class="button-outline">View all videos</a>
        </div>
        <YouTubeEmbed videoId="dQw4w9WgXcQ" title="Placeholder: Welcome to TypeOneDen" />
      </div>
    </section>

    <!-- ── Newsletter ──────────────────────────────────────────── -->
    <section style="padding-block:5rem; position:relative; overflow:hidden;">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="wide-container px-4" style="position:relative;">
        <NewsletterSignup heading="Join the Den newsletter" subtext="Weekly T1D stories, practical tips, and the first look at new resources — straight to your inbox." />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .featured-card {
    display: grid;
  }
  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 1fr 1fr;
    }
  }
  .featured-card:hover {
    border-color: #A67C8A !important;
    box-shadow: 0 8px 40px rgba(166,124,138,0.15);
  }
  .md\:grid-cols-2 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .md\:grid-cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .md\:grid-cols-\[1fr_1\.4fr\] {
      grid-template-columns: 1fr 1.4fr;
    }
  }
</style>

