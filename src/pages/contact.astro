---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Type One Den"
  description="Get in touch with Type One Den for questions, feedback, and collaboration inquiries."
>
  <main class="page-main py-16">
    <div class="max-w-[720px] mx-auto px-4 space-y-10">
      <header class="space-y-5">
        <p class="page-eyebrow">Contact</p>
        <h1 class="text-4xl md:text-5xl" style="font-family: 'Playfair Display', serif;">Let&apos;s connect</h1>
        <p class="text-lg page-muted">Questions, kind notes, media requests, or ideas you&apos;d love to see on the site are always welcome.</p>
        <p class="text-lg"><a href="mailto:hello@typeoneden.com" class="underline decoration-transparent underline-offset-4 transition hover:decoration-current" style="color:var(--color-accent);">hello@typeoneden.com</a></p>
        <p class="page-panel page-muted">For partnership and affiliate inquiries, please include <span class="font-semibold" style="color:var(--color-text-primary);">&ldquo;Collaboration&rdquo;</span> in your subject line.</p>
      </header>

      <section class="page-panel">
        <form name="contact" method="post" action="#" class="space-y-5">
          <input type="hidden" name="form-note" value="Wire this form to Netlify Forms, Basin, or another form service before launch." />
          <div>
            <label for="name" class="mb-2 block text-sm font-medium" style="color:var(--color-text-primary);">Name</label>
            <input id="name" name="name" type="text" required class="page-input" placeholder="Your name" />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-medium" style="color:var(--color-text-primary);">Email</label>
            <input id="email" name="email" type="email" required class="page-input" placeholder="you@example.com" />
          </div>
          <div>
            <label for="subject" class="mb-2 block text-sm font-medium" style="color:var(--color-text-primary);">Subject</label>
            <input id="subject" name="subject" type="text" required class="page-input" placeholder="How can I help?" />
          </div>
          <div>
            <label for="message" class="mb-2 block text-sm font-medium" style="color:var(--color-text-primary);">Message</label>
            <textarea id="message" name="message" rows="6" required class="page-input" placeholder="Write your message here"></textarea>
          </div>
          <div class="space-y-3">
            <button type="submit" class="button-pink">Send message</button>
            <p class="text-sm page-muted">Form submission is currently a placeholder. Wire it to Netlify Forms or your preferred form service before launch.</p>
          </div>
        </form>
      </section>
    </div>
  </main>
</BaseLayout>
