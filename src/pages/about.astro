---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---

<BaseLayout
  title="About | TypeOneDen"
  description="Meet the woman behind TypeOneDen and learn why this space exists for bold, honest life with type 1 diabetes."
>
  <main style="background:var(--color-bg); min-height:100vh;">

    <!-- Hero -->
    <section style="padding:6rem 0 5rem; border-bottom:1px solid var(--color-border);">
      <div class="wide-container px-4">
        <div style="max-width:780px;">
          <p style="font-size:0.65rem; font-weight:700; letter-spacing:0.42em; text-transform:uppercase; color:var(--color-accent); margin:0 0 2rem;">About the Den</p>
          <h1 style="font-family:var(--font-serif); font-size:clamp(2.5rem,6vw,4rem); line-height:0.95; font-weight:700; color:var(--color-text-primary); margin:0 0 2rem; letter-spacing:-0.02em;">
            Living with T1D,<br/><em style="font-style:italic; color:var(--color-accent);">honestly.</em>
          </h1>
          <p style="font-size:1.05rem; line-height:1.9; color:var(--color-text-secondary); max-width:560px; margin:0;">
            I am a woman with type 1 diabetes navigating work, relationships, hormones, snacks, and a pancreas that checked out years ago. This is the place I wish I had when I was figuring it all out.
          </p>
        </div>
      </div>
    </section>

    <!-- Story section -->
    <section style="padding:5rem 0;">
      <div class="wide-container px-4">
        <div style="display:grid; grid-template-columns:1fr; gap:3rem; max-width:920px; margin:0 auto;">

          <div style="display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1.5rem; align-items:start;">
            <!-- Photo placeholder -->
            <div style="aspect-ratio:4/5; background:var(--color-surface); border:1px solid var(--color-border); border-radius:1.5rem; display:flex; align-items:center; justify-content:center; color:var(--color-text-tertiary); font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; text-align:center; padding:1rem;">
              Your photo here
            </div>
            <!-- Stat cards -->
            <div style="display:flex; flex-direction:column; gap:1rem; padding-top:0.5rem;">
              <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:1rem; padding:1.25rem;">
                <p style="font-size:1.75rem; font-weight:700; color:var(--color-text-primary); margin:0; font-family:var(--font-serif);">T1D</p>
                <p style="font-size:0.72rem; color:var(--color-text-tertiary); margin:0.25rem 0 0; text-transform:uppercase; letter-spacing:0.1em;">Since diagnosis</p>
              </div>
              <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:1rem; padding:1.25rem;">
                <p style="font-size:1.75rem; font-weight:700; color:var(--color-accent); margin:0; font-family:var(--font-serif);">Real</p>
                <p style="font-size:0.72rem; color:var(--color-text-tertiary); margin:0.25rem 0 0; text-transform:uppercase; letter-spacing:0.1em;">Talk only</p>
              </div>
              <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:1rem; padding:1.25rem;">
                <p style="font-size:1.75rem; font-weight:700; color:var(--color-text-primary); margin:0; font-family:var(--font-serif);">You</p>
                <p style="font-size:0.72rem; color:var(--color-text-tertiary); margin:0.25rem 0 0; text-transform:uppercase; letter-spacing:0.1em;">Are not alone</p>
              </div>
            </div>
          </div>

          <!-- Story text -->
          <div style="display:flex; flex-direction:column; gap:2rem;">
            <div>
              <h2 style="font-family:var(--font-serif); font-size:1.5rem; color:var(--color-text-primary); margin:0 0 0.75rem;">My story</h2>
              <p style="color:var(--color-text-secondary); line-height:1.9; margin:0;">I was diagnosed with T1D and quickly learned that life does not pause for carb counts, low alerts, or infusion set changes. I had to figure out how to move through work, relationships, travel, and everyday routines while carrying the invisible mental load that comes with this condition. TypeOneDen began as a way to turn that lived experience into something useful, honest, and comforting for others on the same road.</p>
            </div>
            <div>
              <h2 style="font-family:var(--font-serif); font-size:1.5rem; color:var(--color-text-primary); margin:0 0 0.75rem;">Why the Den exists</h2>
              <p style="color:var(--color-text-secondary); line-height:1.9; margin:0;">I started TypeOneDen because I wanted a place that felt less clinical and more like a trusted friend. A place for grounded advice, product recommendations with integrity, and stories that make you feel less alone. Not every day with T1D is inspiring but every day deserves support.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- What is here - feature cards -->
    <section style="padding:4rem 0 5rem; border-top:1px solid var(--color-border); background:var(--color-surface);">
      <div class="wide-container px-4">
        <p style="font-size:0.65rem; font-weight:700; letter-spacing:0.42em; text-transform:uppercase; color:var(--color-accent); margin:0 0 0.75rem;">What's here</p>
        <h2 style="font-family:var(--font-serif); font-size:clamp(1.5rem,3vw,2rem); color:var(--color-text-primary); margin:0 0 2rem;">Everything you actually need</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px,1fr)); gap:1rem;">
          <div style="background:var(--color-bg); border:1px solid var(--color-border); border-radius:1.25rem; padding:1.75rem;">
            <div style="width:2rem; height:2px; background:var(--color-accent); margin-bottom:1.25rem; border-radius:1px;"></div>
            <h3 style="font-size:0.9rem; font-weight:600; color:var(--color-text-primary); margin:0 0 0.5rem;">Real talk</h3>
            <p style="font-size:0.82rem; color:var(--color-text-secondary); line-height:1.65; margin:0;">Emotional honesty on the mental load of T1D</p>
          </div>
          <div style="background:var(--color-bg); border:1px solid var(--color-border); border-radius:1.25rem; padding:1.75rem;">
            <div style="width:2rem; height:2px; background:var(--color-accent); margin-bottom:1.25rem; border-radius:1px;"></div>
            <h3 style="font-size:0.9rem; font-weight:600; color:var(--color-text-primary); margin:0 0 0.5rem;">Practical guides</h3>
            <p style="font-size:0.82rem; color:var(--color-text-secondary); line-height:1.65; margin:0;">Tech, gear, routines, and food that actually works</p>
          </div>
          <div style="background:var(--color-bg); border:1px solid var(--color-border); border-radius:1.25rem; padding:1.75rem;">
            <div style="width:2rem; height:2px; background:var(--color-accent); margin-bottom:1.25rem; border-radius:1px;"></div>
            <h3 style="font-size:0.9rem; font-weight:600; color:var(--color-text-primary); margin:0 0 0.5rem;">Trusted picks</h3>
            <p style="font-size:0.82rem; color:var(--color-text-secondary); line-height:1.65; margin:0;">Honest recommendations nothing I would not use myself</p>
          </div>
          <div style="background:var(--color-bg); border:1px solid var(--color-border); border-radius:1.25rem; padding:1.75rem;">
            <div style="width:2rem; height:2px; background:var(--color-accent); margin-bottom:1.25rem; border-radius:1px;"></div>
            <h3 style="font-size:0.9rem; font-weight:600; color:var(--color-text-primary); margin:0 0 0.5rem;">Community</h3>
            <p style="font-size:0.82rem; color:var(--color-text-secondary); line-height:1.65; margin:0;">Warm, judgment-free space for every kind of T1D day</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section style="padding:5rem 0; border-top:1px solid var(--color-border);">
      <div class="wide-container px-4">
        <div style="max-width:520px; margin:0 auto; text-align:center;">
          <h2 style="font-family:var(--font-serif); font-size:clamp(1.4rem,3vw,1.9rem); color:var(--color-text-primary); margin:0 0 0.75rem;">Stay close to the Den</h2>
          <p style="color:var(--color-text-secondary); margin:0 0 2rem; line-height:1.8;">Real talk, useful resources, and encouragement delivered straight to your inbox.</p>
          <NewsletterSignup heading="Subscribe to the newsletter" subtext="" />
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
