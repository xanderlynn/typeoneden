---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCategoryVar } from '../../utils/categoryColors';

const categories = ['All', 'Life with T1D', 'Tech & Gear', 'Nutrition', 'Advocacy', 'Mindset'];
const posts = (await getCollection('blog').catch(() => []))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    readTime: Math.max(1, Math.ceil(post.body.split(/\s+/).filter(Boolean).length / 200)),
  }));
---

<BaseLayout
  title="Blog | TypeOneDen"
  description="Browse the latest articles from TypeOneDen on life with type 1 diabetes, tech, nutrition, and advocacy."
>
  <main style="background:#0D1117; min-height:100vh;">

    <!-- Page header -->
    <div style="border-bottom:1px solid #30363D; padding:4rem 0 3rem; position:relative; overflow:hidden;">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="wide-container px-4 fade-up" style="position:relative;">
        <p class="section-label" style="margin-bottom:1rem;">All Articles</p>
        <h1 style="font-family:'Playfair Display',serif; font-size:clamp(2rem,5vw,3rem); line-height:1.1; font-weight:700; color:#E6EDF3; margin:0 0 1rem;">
          Stories, guides &amp; honest T1D living
        </h1>
        <p style="color:#8B949E; font-size:0.95rem; line-height:1.7; max-width:520px; margin:0;">
          Real talk on everyday life with T1D, diabetes tech, food, and advocacy — from someone who lives it daily.
        </p>
      </div>
    </div>

    <div class="wide-container px-4" style="padding-block:3rem;">

      <!-- Category filter -->
      <div style="margin-bottom:2rem; display:flex; flex-wrap:wrap; gap:0.5rem;" role="group" aria-label="Filter posts by category">
        {categories.map((cat) => (
          <button
            type="button"
            class="cat-btn"
            data-cat={cat}
            data-active={cat === 'All' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Unified grid — ALL posts, first one is wide -->
      {posts.length > 0 ? (
        <div id="blog-grid" class="blog-grid">
          {posts.map((post, i) => (
            <div
              class:list={['post-card', i === 0 && 'post-card--featured']}
              data-cat={post.data.category}
            >
                  {i === 0 ? (
                /* Featured first post — horizontal layout */
                <a
                  href={`/blog/${post.id}`}
                  class="featured-link group"
                >
                  <div class="featured-accent" style={`background: ${getCategoryVar(post.data.category)};`} />
                  <div class="featured-body">
                    <div>
                      <p style="font-size:0.68rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:#484F58;margin:0 0 0.75rem;">
                        {post.data.pubDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}
                        &nbsp;·&nbsp;Featured
                      </p>
                      <h2 class="featured-title group-hover:text-[#6E9E9C]">
                        {post.data.title}
                      </h2>
                      <p style="color:#8B949E;font-size:0.9rem;line-height:1.7;margin:0.75rem 0 0;">{post.data.description}</p>
                    </div>
                    <span style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.8rem;font-weight:600;color:var(--color-accent);margin-top:1.25rem;">
                      Read article
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                    </span>
                  </div>
                </a>
              ) : (
                <BlogCard
                  title={post.data.title}
                  slug={post.id}
                  pubDate={post.data.pubDate}
                  description={post.data.description}
                  category={post.data.category}
                  image={post.data.image}
                  readTime={post.readTime}
                />
              )}
            </div>
          ))}
        </div>
      ) : (
        <div style="border:1px dashed #30363D;border-radius:1rem;background:#161B22;padding:3rem;text-align:center;color:#484F58;">
          Posts will appear here once the blog collection is populated.
        </div>
      )}
      <div id="no-results" style="display:none; text-align:center; padding:4rem 2rem; color:var(--color-text-secondary); border:1px dashed var(--color-border); border-radius:1rem; margin-top:1rem;">
        No posts in this category yet — check back soon.
      </div>
    </div>
  </main>

  <style>
    .blog-grid {
      display: grid;
      gap: 1.25rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 640px) {
      .blog-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .blog-grid { grid-template-columns: repeat(3, 1fr); }
    }
    .post-card--featured {
      grid-column: 1 / -1;
    }

    /* Featured card */
    .featured-link {
      display: grid;
      grid-template-columns: 6px 1fr;
      border: 1px solid #30363D;
      border-radius: 0.875rem;
      overflow: hidden;
      background: #161B22;
      text-decoration: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      min-height: 160px;
    }
    .featured-link:hover {
      border-color: rgba(94,140,138,0.5);
      box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    }
    .featured-accent {
      width: 6px;
      flex-shrink: 0;
    }
    .featured-body {
      padding: 1.75rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .featured-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.3rem, 3vw, 1.8rem);
      line-height: 1.2;
      font-weight: 700;
      color: #E6EDF3;
      margin: 0;
      transition: color 0.2s;
    }

    /* Filter buttons */
    .cat-btn {
      border: 1px solid #30363D;
      background: #161B22;
      color: #8B949E;
      border-radius: 9999px;
      padding: 0.35rem 0.9rem;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.02em;
    }
    .cat-btn:hover {
      border-color: var(--color-accent);
      color: #E6EDF3;
    }
    .cat-btn[data-active="true"] {
      border-color: var(--color-accent);
      background: var(--color-accent-dim);
      color: var(--color-accent-hover);
    }
  </style>

  <script is:inline>
    const btns = Array.from(document.querySelectorAll('.cat-btn'));
    const cards = Array.from(document.querySelectorAll('.post-card'));

    function setFilter(cat) {
      btns.forEach(b => b.setAttribute('data-active', b.dataset.cat === cat ? 'true' : 'false'));
      let visibleCount = 0;
      cards.forEach(c => {
        const matches = cat === 'All' || c.dataset.cat === cat;
        c.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });
      const noResults = document.getElementById('no-results');
      if (noResults) noResults.style.display = visibleCount === 0 ? '' : 'none';
      const url = new URL(window.location.href);
      cat === 'All' ? url.searchParams.delete('category') : url.searchParams.set('category', cat);
      window.history.replaceState({}, '', url);
    }

    const initial = new URLSearchParams(window.location.search).get('category') || 'All';
    setFilter(initial);

    btns.forEach(b => b.addEventListener('click', () => setFilter(b.dataset.cat || 'All')));
  </script>
</BaseLayout>
