---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'TypeOneDen is a Type 1 Diabetes lifestyle site for women living boldly.',
  ogImage,
} = Astro.props;

const siteName = 'TypeOneDen';
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonical = new URL(`${Astro.url.pathname}${Astro.url.search}`, Astro.site ?? Astro.url).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).toString() : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="TypeOneDen RSS" href="/rss.xml" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" />

    <ViewTransitions />
  </head>
  <body class="page-main">
    <div class="flex min-h-screen flex-col">
      <Nav />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Scroll entrance animation observer -->
    <script is:inline>
      function initFadeUp() {
        const els = document.querySelectorAll('.fade-up:not(.visible)');
        if (!els.length) return;
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
          { threshold: 0.08, rootMargin: '0px 0px -48px 0px' }
        );
        els.forEach((el) => observer.observe(el));
      }
      initFadeUp();
      document.addEventListener('astro:page-load', initFadeUp);
    </script>

    <!-- Dark/light theme init (prevents flash) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        // Default to dark; only honour light if explicitly saved by user
        const theme = saved || 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </body>
</html>
